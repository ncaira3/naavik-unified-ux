# Top-level docker-compose environment template.
# Copy to `.env` (gitignored) and fill in real values for local dev.

# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_NAME=naavik_demo
DB_USER=naavik_user
DB_PASSWORD=change-me

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=http://localhost:3000

# pgAdmin Configuration
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Demo Configuration
DEMO_MODE=true
ENABLE_WEBSOCKETS=true

# OpenAI (optional) — enables agentic Conversational App Builder.
# Without this, a fallback gives context-aware but canned responses.
# OPENAI_API_KEY=sk-your-openai-key-here
