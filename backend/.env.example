# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=naavik_demo
DB_USER=naavik_user
DB_PASSWORD=change-me

# Authentication
# Use a long random string in production (e.g. `openssl rand -hex 64`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# OpenAI API
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Mapbox (server-side token, can differ from frontend public token)
MAPBOX_TOKEN=your-mapbox-token-here

# Admin Credentials
# REQUIRED — server will refuse to start if these are unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CORS
CORS_ORIGIN=http://localhost:5173

# Cache TTL (seconds)
CACHE_TTL=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Remote Database Connector (optional)
REMOTE_DB_URL=
REMOTE_DB_TIMEOUT=600000
KPI_CACHE_TTL=300
