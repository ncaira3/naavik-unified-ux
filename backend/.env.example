# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_NAME=naavik_demo
DB_USER=naavik_user
DB_PASSWORD=change-me

# Authentication
# Use a long random string in production (e.g. `openssl rand -hex 64`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# OpenAI API
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
# Model used by every LLM call site (agent orchestrator, tools, chart generator,
# conversational builder). gpt-4o-mini is fast and cheap; switch to gpt-4o or
# gpt-4.1 for higher quality at higher latency/cost.
OPENAI_AGENT_MODEL=gpt-4o-mini

# Mapbox (server-side token, can differ from frontend public token)
MAPBOX_TOKEN=your-mapbox-token-here

# Admin Credentials
# REQUIRED — server will refuse to start if these are unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GoAira2026!
# CORS
CORS_ORIGIN=http://localhost:5173

# Cache TTL (seconds)
CACHE_TTL=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Remote Database Connector (optional)
REMOTE_DB_URL=
REMOTE_DB_TIMEOUT=600000
KPI_CACHE_TTL=300

# Local Events providers (free tiers)
# Ticketmaster Discovery — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# SeatGeek — https://platform.seatgeek.com/
SEATGEEK_CLIENT_ID=

# Live RCA service (services/rca)
RCA_SERVICE_URL=http://localhost:9444
RCA_REQUEST_TIMEOUT_MS=180000

# External integrations (MCP + A2A)
SECRET_PROVIDER=postgres                                    # postgres | gcp | azure
INTEGRATION_SECRET_KEY=                                     # base64-encoded 32 bytes
NAAVIK_MCP_BOOTSTRAP_PATH=./config/mcp-servers.bootstrap.json
# GCP_PROJECT_ID=                                           # required if SECRET_PROVIDER=gcp
# GCP_SECRET_PREFIX=naavik
# AZURE_KEY_VAULT_URL=                                      # required if SECRET_PROVIDER=azure
# AZURE_SECRET_PREFIX=naavik

# Mirror staleness fallthrough — when the freshest mirror row is more than
# this many days older than the requested date, mirrorOrRemote() automatically
# falls through to the remote MSSQL. Set to a large value to disable.
MIRROR_MAX_STALENESS_DAYS=7
